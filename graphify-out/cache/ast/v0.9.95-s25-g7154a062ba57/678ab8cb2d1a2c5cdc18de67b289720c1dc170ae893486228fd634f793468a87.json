{"nodes": [{"id": "$graphify-root$_apps_website_src_content_blog_m3u_playlist_epg_setup_guide_mdx", "label": "m3u-playlist-epg-setup-guide.mdx", "file_type": "document", "node_kind": "page", "source_file": "apps/website/src/content/blog/m3u-playlist-epg-setup-guide.mdx", "source_location": "L1", "frontmatter": {"title": "How to Load an M3U Playlist and Add an EPG in IPTVnator", "description": "Import an M3U or M3U8 playlist into IPTVnator from a URL, a file or pasted text, keep it updated, and attach an XMLTV program guide. Covers channel groups, catch-up attributes, EPG matching by tvg-id, and the usual reasons a playlist or guide does not load.", "pubDate": "2026-09-04", "author": "4gray", "heroImage": "/iptvnator/blog/guides/screenshots/guide-m3u-live-groups-dark.png", "tags": ["guide", "m3u", "epg"], "draft": false, "faq": [{"q": "What is the difference between an M3U and an M3U8 playlist?", "a": "Nothing that matters to IPTVnator. Both are the same text format; M3U8 only signals that the file is UTF-8 encoded. Both extensions are accepted from a URL, a file or pasted text, and both can carry the same attributes for logos, groups, program guide ids and catch-up."}, {"q": "Does IPTVnator refresh a playlist that was added from a URL?", "a": "On request always, and automatically on every start when you enable Auto-update in the playlist details. The desktop app downloads the file again, keeps your favorites and settings, and reports what changed. A playlist imported from a local file is refreshed from that file."}, {"q": "Why do my channels show no program information?", "a": "The channel is not matched to a guide entry. IPTVnator matches by tvg-id first, then by tvg-name, then by the channel name. Check that the playlist carries tvg-id values that exist in the XMLTV source, or map the channel by hand with a right-click and &quot;Map EPG channel&quot;. The program guide is a desktop feature; the browser version does not load XMLTV."}, {"q": "Do I have to add the EPG URL myself?", "a": "Not when the playlist declares it. Many providers put url-tvg or x-tvg-url in the first line of the file, and IPTVnator imports those sources automatically and lists them in the playlist details. Otherwise add the URL under Settings \u203a EPG or in the playlist details."}, {"q": "Does catch-up work with M3U playlists?", "a": "Yes, when the provider marks channels with catch-up attributes such as catchup, catchup-source and catchup-days, or with tvg-rec and timeshift. Archived programs can then be started from the timeline under the player. Without those attributes the timeline shows the schedule only."}, {"q": "Can I open a playlist file by double-clicking it?", "a": "Yes. The desktop app registers the .m3u and .m3u8 extensions, so opening a file from the file manager, dropping it anywhere onto the IPTVnator window, or passing it on the command line imports it like the dialog does."}, {"q": "Why does the browser version warn about a proxy when I paste a playlist URL?", "a": "Browsers block cross-origin downloads, so the browser version fetches remote playlists through a proxy. The self-hosted Docker image ships its own backend for that. If the playlist URL contains credentials you would rather not route through a proxy, import the file instead."}]}}, {"id": "$graphify-root$_apps_website_src_content_blog_m3u_playlist_epg_setup_guide_three_ways_to_import", "label": "Three ways to import", "file_type": "document", "node_kind": "heading", "source_file": "apps/website/src/content/blog/m3u-playlist-epg-setup-guide.mdx", "source_location": "L48"}, {"id": "$graphify-root$_apps_website_src_content_blog_m3u_playlist_epg_setup_guide_inside_the_playlist", "label": "Inside the playlist", "file_type": "document", "node_kind": "heading", "source_file": "apps/website/src/content/blog/m3u-playlist-epg-setup-guide.mdx", "source_location": "L74"}, {"id": "$graphify-root$_apps_website_src_content_blog_m3u_playlist_epg_setup_guide_keep_the_playlist_current", "label": "Keep the playlist current", "file_type": "document", "node_kind": "heading", "source_file": "apps/website/src/content/blog/m3u-playlist-epg-setup-guide.mdx", "source_location": "L93"}, {"id": "$graphify-root$_apps_website_src_content_blog_m3u_playlist_epg_setup_guide_attach_a_program_guide", "label": "Attach a program guide", "file_type": "document", "node_kind": "heading", "source_file": "apps/website/src/content/blog/m3u-playlist-epg-setup-guide.mdx", "source_location": "L106"}, {"id": "$graphify-root$_apps_website_src_content_blog_m3u_playlist_epg_setup_guide_how_channels_are_matched", "label": "How channels are matched", "file_type": "document", "node_kind": "heading", "source_file": "apps/website/src/content/blog/m3u-playlist-epg-setup-guide.mdx", "source_location": "L138"}, {"id": "$graphify-root$_apps_website_src_content_blog_m3u_playlist_epg_setup_guide_catch_up_from_the_timeline", "label": "Catch-up from the timeline", "file_type": "document", "node_kind": "heading", "source_file": "apps/website/src/content/blog/m3u-playlist-epg-setup-guide.mdx", "source_location": "L151"}, {"id": "$graphify-root$_apps_website_src_content_blog_m3u_playlist_epg_setup_guide_troubleshooting", "label": "Troubleshooting", "file_type": "document", "node_kind": "heading", "source_file": "apps/website/src/content/blog/m3u-playlist-epg-setup-guide.mdx", "source_location": "L159"}, {"id": "$graphify-root$_apps_website_src_content_blog_m3u_playlist_epg_setup_guide_related", "label": "Related", "file_type": "document", "node_kind": "heading", "source_file": "apps/website/src/content/blog/m3u-playlist-epg-setup-guide.mdx", "source_location": "L179"}], "edges": [{"source": "$graphify-root$_apps_website_src_content_blog_m3u_playlist_epg_setup_guide_mdx", "target": "$graphify-root$_apps_website_src_content_blog_m3u_playlist_epg_setup_guide_three_ways_to_import", "relation": "contains", "confidence": "EXTRACTED", "source_file": "apps/website/src/content/blog/m3u-playlist-epg-setup-guid